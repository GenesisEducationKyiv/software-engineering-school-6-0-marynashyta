DB_HOST=localhost
DB_PORT=3306
DB_NAME=release_notifications
DB_USER=app
DB_PASS=secret
DB_ROOT_PASS=rootsecret

GITHUB_TOKEN=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@releases-api.app
MAIL_FROM_NAME="Release Notifications"

APP_URL=http://localhost:8080
SCANNER_INTERVAL=300

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Notification driver:
#   in_process — built-in EmailService (instant rollback)
#   http       — notification-service REST API (legacy, kept for comparison)
#   amqp       — publish commands to RabbitMQ; notification-consumer delivers emails
#   grpc       — notification-service gRPC API (HTTP/2 + Protobuf)
NOTIFICATION_DRIVER=amqp
NOTIFICATION_SERVICE_URL=http://notification:80
NOTIFICATION_SERVICE_GRPC=notification-grpc:50051

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

API_KEY=

LOG_LEVEL=debug
LOG_PATH=php://stderr
