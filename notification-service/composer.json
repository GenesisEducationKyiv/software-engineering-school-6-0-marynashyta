{
    "name": "release-notification/notification-service",
    "description": "Standalone notification microservice — sends confirmation and release emails",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "php-di/php-di": "^7.1",
        "monolog/monolog": "^3.0",
        "php-amqplib/php-amqplib": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "NotificationService\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "test":    "phpunit",
        "analyse": "phpstan analyse --no-progress"
    }
}
