{
    "name": "release-notification/scanner-service",
    "description": "Standalone scanner microservice — polls GitHub for new releases and dispatches notifications",
    "type": "project",
    "require": {
        "php": "^8.2",
        "php-di/php-di": "^7.1",
        "guzzlehttp/guzzle": "^7.8",
        "php-amqplib/php-amqplib": "^3.6",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.0",
        "deptrac/deptrac": "^4.6",
        "phparkitect/phparkitect": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "ScannerService\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "test":       "phpunit",
        "analyse":    "phpstan analyse --no-progress",
        "arch:layers": "deptrac analyse --no-progress --fail-on-uncovered",
        "arch:rules":  "phparkitect check",
        "arch":        ["@arch:layers", "@arch:rules"]
    }
}
